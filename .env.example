LLM_PROVIDER=gemini          # gemini | anthropic
AI_MODEL=gemini-3.6-flash   # modelos válidos 2026: gemini-3.6-flash, gemini-3.5-flash, gemini-2.5-pro

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MAX_OUTPUT_TOKENS=1024
# Para probar Claude con saldo limitado:
# LLM_PROVIDER=anthropic
# AI_MODEL=claude-haiku-4-5

SEARCH_API_KEY=

PORT=3001
# Acceso local por defecto. Para acceso remoto, implementar autenticacion primero.
HOST=127.0.0.1
JARVIS_MODE=local           # local | cloud
# Para acceso remoto: clave aleatoria de al menos 32 caracteres, nunca VITE_*.
JARVIS_ACCESS_KEY=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Solo backend de nube (Neon/PostgreSQL); no reemplaza SQLite local.
DATABASE_URL=
DB_PATH=./data/jarvis.db
ALLOWED_DIRS=C:/Users/fede/Documents
USER_NAME=Federico

# n8n (Fase 1)
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
# URL que usa n8n para volver a JARVIS. Desde el contenedor Docker, localhost NO funciona:
# usar http://host.docker.internal:3001 (ver n8n/README.md)
JARVIS_BASE_URL=http://host.docker.internal:3001
