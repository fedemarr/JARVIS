{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/backend/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/memory/schema.sql','dist/backend/src/memory/schema.sql')\"",
    "start": "node dist/backend/src/server.js",
    "llm:test": "tsx src/llm/test.ts",
    "n8n:test": "tsx src/n8n/test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "@google/generative-ai": "^0.24.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "ignore": "^7.0.6",
    "mathjs": "^15.2.0",
    "playwright": "^1.62.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3"
  }
}
